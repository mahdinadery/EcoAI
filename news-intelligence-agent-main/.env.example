# PostgreSQL connection used by Drizzle ORM (local sandbox default).
# After changing environments, run `npm run db:ensure` once — it is idempotent
# and additive-only (creates missing tables/columns/indexes, never drops data).
# Note: `npm start` (prestart) and `npm install` (postinstall) now attempt this
# sync automatically and soft-fail, so shell-less platforms (Render/Koyeb free
# tiers) keep the schema in sync on every deploy. See DEPLOYMENT.md.
DATABASE_URL=

# DNS workaround for Iran-hosted servers (getaddrinfo ENOTFOUND on foreign DB
# hosts): append libpq-style params to DATABASE_URL —
#   ?sslmode=require&hostaddr=1.2.3.4   connect by raw IP, TLS keeps verifying
#                                       the original hostname (no DNS lookup)
#   &sslservername=db.example.com      TLS/SNI name when it differs from the URL
#   &sslnoverify=1                     self-signed test databases only
# Example: postgres://user:pass@db.example.com:5432/app?sslmode=require&hostaddr=1.2.3.4

# Bale Bot credentials.
# Real values must be provided through the secure environment/secrets mechanism.
# Never commit real credentials, and never expose them as NEXT_PUBLIC_* variables.
BALE_BOT_TOKEN=
BALE_CHAT_ID=

# Delivery mode (used by the Bale *test* card only):
#   live    (default) -> send through the real Bale Bot API
#   dry-run           -> skip the network, only record messages in the local outbox
BALE_DELIVERY_MODE=

# News source (Milestone 3): a single public RSS/Atom feed URL.
# Kept in the environment so the source can be swapped without code changes.
NEWS_SOURCE_RSS_URL=

# AI Provider Credentials (Milestone 4):
# Used for structured analysis, summarization and relevance scoring.
AI_API_KEY=
# Optional: defaults to https://api.openai.com/v1 if not specified.
AI_API_BASE_URL=
# Optional: model name (AI_MODEL is accepted as an alias).
# NOTE: the model must exist for your account — Groq accounts vary, list yours with:
#   curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $AI_API_KEY"
AI_API_MODEL=
AI_MODEL=

# ---------------------------------------------------------------------------
# Auto-delivery rules (Milestone 6)
# News is sent automatically when it ALREADY has an AI analysis AND matches all
# of the thresholds below. Every value has a safe default, so leaving these
# unset keeps auto-send ON with a conservative policy (Local only, importance>=50).
#
# NOTE: these env values are the FALLBACK policy. When the AI Configuration
# dashboard (/admin/ai-config -> "سیاست ارسال خودکار") has "use custom" enabled,
# the versioned dashboard policy takes precedence over everything below.
#
# SCHEDULED AUTO-PUBLISHING (recommended): the dashboard card
# "ارسال خودکار زمان‌بندی‌شده" stores its own times/destination/thresholds in the
# database (table agent_schedules) and ignores the policy below. It is triggered
# by .github/workflows/scheduled-agent.yml (APP_URL + ADMIN_ACCESS_KEY secrets).
# ---------------------------------------------------------------------------

# "true" (default) | "false"
AUTO_SEND_ENABLED=
# local (default) | bale | both  — "local" is the safe default for this sandbox
AUTO_SEND_DESTINATION=
# Minimum scores, 0-100
AUTO_SEND_MIN_IMPORTANCE=
AUTO_SEND_MIN_RELEVANCE=
AUTO_SEND_MIN_NOVELTY=
# "true" (default) requires the AI's own shouldSend=true before sending
AUTO_SEND_REQUIRE_AI_RECOMMENDATION=
# Restrict to specific Persian categories, comma separated. Empty = all categories.
# e.g. AUTO_SEND_CATEGORIES=اقتصاد,سیاست,فناوری
AUTO_SEND_CATEGORIES=
# Max articles processed per pass (1-100)
AUTO_SEND_MAX_ITEMS=

# ---------------------------------------------------------------------------
# Admin area access gate (all /admin pages + their API routes)
# ---------------------------------------------------------------------------
# This project has no full login/session system yet. All /admin pages and
# their API routes are optionally protected by this shared key instead:
#   - unset (default) -> the admin area is open to anyone who can reach it
#   - set              -> admin pages show a "key" popup; a successful login
#                         stores an HttpOnly session cookie for 12 hours.
#                         Scripts/CI can keep using the `x-admin-key` header,
#                         and `?key=` links still work (they are exchanged for
#                         the cookie and removed from the URL automatically).
# Replace with real authentication when the project adds one.
ADMIN_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Outbound proxy for RSS fetching (Iranian-source friendly)
# ---------------------------------------------------------------------------
# Many Iranian news hosts (Arvan/eirid and others) silently drop requests from
# non-Iran server IPs: TCP opens, but no response ever arrives. If your app
# runs outside Iran, point this at any reachable proxy (e.g. an Iran-side one)
# and every feed fetch (test/fetch/run-due/dashboard) will be routed through it:
#   NEWS_FETCH_PROXY_URL=http://127.0.0.1:8080
# Leave empty for direct connections (default). Credentials in the URL are
# never logged or returned to the browser.
NEWS_FETCH_PROXY_URL=

# Optional relevance/importance/freshness experiment. Default: disabled.
# Adds a short shadow object to the EXISTING AI call; never changes publishing rules.
# Run npm run db:ensure before enabling. See docs/shadow-evaluation.md.
AI_SHADOW_EVALUATION=false
